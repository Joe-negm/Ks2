      chessClock.incrementMs = safeInc * 1000;
      chessClock.isRunning = false;
      chessClock.activePlayer = 0;
      chessClock.timeMs = [chessClock.baseMs, chessClock.baseMs];
      chessClock.moves = [0, 0];
