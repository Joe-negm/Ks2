  <script>
    // =========================================================================
    // SAFE STORAGE & BROWSER ENVIRONMENT HELPERS
    // =========================================================================
    const memoryStorage = {};
    function safeGetItem(key) {
      try {
        return window.localStorage.getItem(key);
      } catch (e) {
        return Object.prototype.hasOwnProperty.call(memoryStorage, key) ? memoryStorage[key] : null;
      }
    }
    function safeSetItem(key, value) {
      try {
        window.localStorage.setItem(key, value);
      } catch (e) {
        memoryStorage[key] = String(value);
      }
    }

    function showToast(message, type = "info") {
      try {
        const container = document.getElementById("toastContainer");
        if (!container) return;
        const el = document.createElement("div");
        const colorMap = {
          success: "bg-emerald-600 text-white border-emerald-300",
          error: "bg-rose-500 text-white border-rose-300",
          warning: "bg-amber-400 text-slate-950 border-amber-200",
          info: "bg-sky-700 text-white border-sky-300"
        };
        el.className = `px-3.5 py-2 rounded-2xl shadow-lg border-2 text-xs font-black pointer-events-auto ${colorMap[type] || colorMap.info}`;
        el.textContent = message;
        container.appendChild(el);
        setTimeout(() => {
          if (el.parentNode) el.parentNode.removeChild(el);
        }, 2800);
      } catch (e) {
        // Ignore toast errors
      }
    }

    function escapeHtml(str) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    // =========================================================================
    // LOGO FALLBACK & CUSTOM UPLOAD
    // =========================================================================
    function handleLogoFallback(imgEl) {
      try {
        if (imgEl) imgEl.style.display = "none";
        const fb = document.getElementById("schoolLogoFallback");
        if (fb) {
          fb.classList.remove("hidden");
          fb.classList.add("flex");
        }
      } catch (e) {}
    }

    function uploadCustomLogo(event) {
      try {
        const input = event && event.target;
        const file = input && input.files && input.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (e) {
          const imgEl = document.getElementById("schoolLogoImg");
          const fb = document.getElementById("schoolLogoFallback");
          if (imgEl && e.target && e.target.result) {
            imgEl.src = e.target.result;
            imgEl.style.display = "block";
          }
          if (fb) {
            fb.classList.add("hidden");
            fb.classList.remove("flex");
          }
          if (input) input.value = "";
          showToast("School logo PNG updated!", "success");
        };
        reader.onerror = function () {
          if (input) input.value = "";
          showToast("Could not read logo file.", "error");
        };
        reader.readAsDataURL(file);
      } catch (err) {
        showToast("Could not load logo image.", "error");
      }
    }

    // =========================================================================
    // DYNAMIC WEB AUDIO SOUND EFFECTS & SPEECH SYNTHESIS
    // =========================================================================
    let soundEnabled = true;
    let audioCtx = null;

    function ensureAudioContext() {
      if (!soundEnabled) return null;
      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return null;
        if (!audioCtx) audioCtx = new AudioContextClass();
        if (audioCtx.state === "suspended") {
          audioCtx.resume().catch(() => {});
        }
        return audioCtx;
      } catch (e) {
        return null;
      }
    }

    function playTone(freq = 520, duration = 0.08, type = "sine", gainVal = 0.08, delaySec = 0) {
      if (!soundEnabled) return;
      try {
        const ctx = ensureAudioContext();
        if (!ctx) return;
        const startAt = ctx.currentTime + delaySec;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, startAt);
        gain.gain.setValueAtTime(0.001, startAt);
        gain.gain.linearRampToValueAtTime(gainVal, startAt + 0.015);
        gain.gain.exponentialRampToValueAtTime(0.001, startAt + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(startAt);
        osc.stop(startAt + duration + 0.02);
      } catch (e) {}
    }

    // Cheerful ascending major fanfare + sparkling chimes + pop burst for CORRECT answers
    function playCorrectFanfare() {
      if (!soundEnabled) return;
      try {
        const ctx = ensureAudioContext();
        if (!ctx) return;

        // Bright major arpeggio fanfare (C5 -> E5 -> G5 -> C6)
        const notes = [
          { f: 523.25, t: 0.00, d: 0.14, type: "triangle", g: 0.14 },
          { f: 659.25, t: 0.10, d: 0.14, type: "triangle", g: 0.14 },
          { f: 783.99, t: 0.20, d: 0.16, type: "triangle", g: 0.15 },
          { f: 1046.50, t: 0.31, d: 0.38, type: "sine", g: 0.18 }
        ];
        notes.forEach(n => playTone(n.f, n.d, n.type, n.g, n.t));

        // Sparkling high bell chimes
        playTone(1318.51, 0.25, "sine", 0.08, 0.36);
        playTone(1567.98, 0.32, "sine", 0.09, 0.44);
        playTone(2093.00, 0.40, "sine", 0.07, 0.52);

        // Soft celebratory pop burst using short filtered noise
        const bufferSize = Math.floor(ctx.sampleRate * 0.22);
        const noiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          output[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ctx.sampleRate * 0.06));
        }
        const whiteNoise = ctx.createBufferSource();
        whiteNoise.buffer = noiseBuffer;
        const filter = ctx.createBiquadFilter();
        filter.type = "bandpass";
        filter.frequency.setValueAtTime(1400, ctx.currentTime + 0.30);
        const nGain = ctx.createGain();
        nGain.gain.setValueAtTime(0.08, ctx.currentTime + 0.30);
        nGain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.52);
        whiteNoise.connect(filter);
        filter.connect(nGain);
        nGain.connect(ctx.destination);
        whiteNoise.start(ctx.currentTime + 0.30);
      } catch (e) {}
    }

    // Gentle, comical playful boing + encouraging bounce for WRONG answers
    function playWrongBoing() {
      if (!soundEnabled) return;
      try {
        const ctx = ensureAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;

        // Comical rubber-band boing slide
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(340, now);
        osc.frequency.exponentialRampToValueAtTime(195, now + 0.18);
        osc.frequency.exponentialRampToValueAtTime(255, now + 0.30);
        osc.frequency.exponentialRampToValueAtTime(175, now + 0.46);

        gain.gain.setValueAtTime(0.001, now);
        gain.gain.linearRampToValueAtTime(0.13, now + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.48);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.50);

        // Gentle encouraging upward nudge chime at the end
        playTone(392.00, 0.14, "triangle", 0.06, 0.44);
      } catch (e) {}
    }

    function playWheelWinnerFanfare() {
      playTone(587.33, 0.11, "triangle", 0.11, 0.00);
      playTone(739.99, 0.11, "triangle", 0.11, 0.10);
      playTone(880.00, 0.25, "sine", 0.13, 0.20);
    }

    function playChessClickSound() {
      playTone(820, 0.045, "triangle", 0.11);
    }

    function playFlagSound() {
      playTone(320, 0.22, "triangle", 0.11, 0);
      playTone(240, 0.32, "triangle", 0.11, 0.18);
    }

    function speakText(text) {
      if (!soundEnabled || !text) return;
      try {
        if ("speechSynthesis" in window) {
          window.speechSynthesis.cancel();
          const utter = new SpeechSynthesisUtterance(text);
          utter.rate = 0.96;
          utter.pitch = 1.08;
          window.speechSynthesis.speak(utter);
        }
      } catch (e) {}
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      if (!soundEnabled) {
        try {
          if ("speechSynthesis" in window) window.speechSynthesis.cancel();
        } catch (e) {}
      } else {
        ensureAudioContext();
        playTone(660, 0.1, "sine", 0.08);
      }
      updateSoundButtonUI();
      showToast(soundEnabled ? "Sound & voice ON 🔊" : "Sound & voice OFF 🔇", "info");
    }

    function updateSoundButtonUI() {
      const icon = document.getElementById("soundIcon");
      const label = document.getElementById("soundLabel");
      if (icon) icon.textContent = soundEnabled ? "🔊" : "🔇";
      if (label) label.textContent = soundEnabled ? "Sound: ON" : "Sound: OFF";
    }

    // =========================================================================
    // DYNAMIC VISUAL EFFECTS (CONFETTI, FLOATING STARS & CARD ANIMATIONS)
    // =========================================================================
    function triggerAnswerFeedbackEffects(classIdx, isCorrect, ptsEarned = 10) {
      const card = document.getElementById(`questionCard-${classIdx}`);
      const scoreBox = document.getElementById(`scoreBox-${classIdx}`);
      const arena = document.getElementById(`arena-${classIdx}`);

      if (card) {
        card.classList.remove("anim-correct-card", "anim-wrong-card");
        void card.offsetWidth; // Force reflow so animation replays cleanly
        card.classList.add(isCorrect ? "anim-correct-card" : "anim-wrong-card");
        setTimeout(() => {
          card.classList.remove("anim-correct-card", "anim-wrong-card");
        }, 900);
      }

      if (isCorrect) {
        // Floating "+10 / +20 / +30 ⭐" badge rising from the class scoreboard
        if (scoreBox) {
          const rect = scoreBox.getBoundingClientRect();
          const badge = document.createElement("div");
          badge.className = "floating-reward-badge px-3 py-1 rounded-full bg-amber-300 text-slate-950 border-2 border-white shadow-lg font-black text-sm sm:text-base whitespace-nowrap";
          badge.style.left = `${rect.left + rect.width / 2}px`;
          badge.style.top = `${rect.top}px`;
          badge.textContent = `🎉 SUPERSTAR! +${ptsEarned} ⭐`;
          document.body.appendChild(badge);
          setTimeout(() => {
            if (badge.parentNode) badge.parentNode.removeChild(badge);
          }, 1400);
        }

        // Confetti burst particles over the winning class arena
        if (arena) {
          const rect = arena.getBoundingClientRect();
          const originX = rect.left + rect.width * 0.55;
          const originY = rect.top + rect.height * 0.35;
          const colors = ["#F59E0B", "#10B981", "#3B82F6", "#EC4899", "#8B5CF6", "#FACC15"];
          const shapes = ["★", "●", "◆", "▲", "✨"];

          for (let i = 0; i < 24; i++) {
            const p = document.createElement("div");
            p.className = "confetti-piece font-black select-none";
            p.textContent = shapes[i % shapes.length];
            p.style.color = colors[i % colors.length];
            p.style.fontSize = `${12 + (i % 4) * 4}px`;
            p.style.left = `${originX}px`;
            p.style.top = `${originY}px`;
            const angle = (Math.PI * 2 * i) / 24 + (Math.random() - 0.5) * 0.3;
            const dist = 65 + Math.random() * 120;
            const tx = Math.round(Math.cos(angle) * dist);
            const ty = Math.round(Math.sin(angle) * dist + 55);
            const rot = Math.round((Math.random() - 0.5) * 540);
            p.style.setProperty("--tx", `${tx}px`);
            p.style.setProperty("--ty", `${ty}px`);
            p.style.setProperty("--rot", `${rot}deg`);
            document.body.appendChild(p);
            setTimeout(() => {
              if (p.parentNode) p.parentNode.removeChild(p);
            }, 1300);
          }
        }
      } else {
        // Encouraging popup over the question card
        if (card) {
          const rect = card.getBoundingClientRect();
          const badge = document.createElement("div");
          badge.className = "floating-reward-badge px-3 py-1 rounded-full bg-rose-100 text-rose-800 border-2 border-rose-300 shadow-md font-black text-xs sm:text-sm whitespace-nowrap";
          badge.style.left = `${rect.left + rect.width / 2}px`;
          badge.style.top = `${rect.top + 24}px`;
          badge.textContent = "💪 Good try! Keep going!";
          document.body.appendChild(badge);
          setTimeout(() => {
            if (badge.parentNode) badge.parentNode.removeChild(badge);
          }, 1350);
        }
      }
    }

    // =========================================================================
    // YEAR 2 & YEAR 3 MATHEMATICS QUESTION BANK (225 QUESTIONS — 9 TOPICS)
    // =========================================================================
    const TOPICS = [
      "Place Value & Partitioning",
      "Addition & Subtraction",
      "Multiplication & Division",
      "Fractions",
      "2D & 3D Shapes",
      "Number Patterns & Sequences",
      "Time & Calendar",
      "Measurement & Money",
      "Data & Word Problems"
    ];

    function buildYear2And3QuestionBank() {
      const bank = [];
      let idCounter = 1;

      function addQ(topic, points, q, answer, hint, isWordProblem = false) {
        const id = `builtin-${String(idCounter++).padStart(3, "0")}`;
        bank.push({
          id,
          topic,
          points,
          q,
          answer: String(answer),
          hint: hint || "Take your time and count carefully!",
          isCustom: false,
          isWordProblem: points === 30 ? true : isWordProblem
        });
      }

      // 1. PLACE VALUE & PARTITIONING (25 Qs: 9 Easy 10p, 8 Med 20p, 8 Hard 30p)
      [
        ["How many tens and ones are in 47?", "4 tens and 7 ones", "The first digit shows tens, the second shows ones."],
        ["What number is 10 more than 36?", "46", "Add 1 to the tens digit."],
        ["What number is 10 less than 82?", "72", "Take away 1 ten from 82."],
        ["Which number is bigger: 68 or 86?", "86", "8 tens is bigger than 6 tens."],
        ["Write 50 + 9 as one number.", "59", "5 tens and 9 ones make 59."],
        ["What is the value of the digit 3 in 38?", "30", "3 is in the tens place."],
        ["Write the number forty-five in digits.", "45", "Forty is 40, plus 5."],
        ["Which number is smaller: 104 or 140?", "104", "Compare the tens digit: 0 tens is less than 4 tens."],
        ["What number comes right after 99?", "100", "99 + 1 = 100."]
      ].forEach(([q, a, h]) => addQ("Place Value & Partitioning", 10, q, a, h));

      [
        ["Partition 346 into hundreds, tens, and ones.", "300 + 40 + 6", "3 hundreds, 4 tens, and 6 ones."],
        ["What number is 100 more than 275?", "375", "Add 1 to the hundreds digit."],
        ["Order from smallest to largest: 215, 152, 251.", "152, 215, 251", "Look at the hundreds digit first."],
        ["Round 67 to the nearest 10.", "70", "67 is closer to 70 than 60."],
        ["What is the value of 5 in 529?", "500", "5 is in the hundreds column."],
        ["What number is 10 less than 204?", "194", "Count back 10 from 204."],
        ["Make the biggest 2-digit number using digits 3 and 8.", "83", "Put the larger digit in the tens place."],
        ["Round 43 to the nearest 10.", "40", "3 ones round down to 40."]
      ].forEach(([q, a, h]) => addQ("Place Value & Partitioning", 20, q, a, h));

      [
        ["Maya thinks of a 2-digit number. It has 6 tens, and its ones digit is 3 more than its tens digit. What is Maya's number?", "69", "Tens = 6; ones = 6 + 3 = 9."],
        ["Leo has number cards 4, 1, and 7. What is the smallest 3-digit number he can make using all three cards?", "147", "Put the smallest digit in the hundreds place."],
        ["A treasure chest code has 3 hundreds, 0 tens, and 8 ones. If you add 20 to the code, what number do you get?", "328", "308 + 20 = 328."],
        ["Sam is thinking of a number between 40 and 50. The sum of its two digits is 11. What is Sam's number?", "47", "4 + 7 = 11."],
        ["There are 245 stickers in a red box and 100 more stickers in a blue box. How many stickers are in the blue box?", "345", "245 + 100 = 345."],
