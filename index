    // =========================================================================
    // DUAL COMPETITION CHESS CLOCK ENGINE
    // =========================================================================
    const chessClock = {
      baseMs: 5 * 60 * 1000,
      incrementMs: 3 * 1000,
      timeMs: [5 * 60 * 1000, 5 * 60 * 1000],
      activePlayer: 0,
      isRunning: false,
      moves: [0, 0],
      flagged: [false, false],
      perQuestionReset: false,
      autoSwitchOnAnswer: true,
      lastTickTimestamp: null,
      intervalId: null,
      lastWarnedSec: [null, null]
