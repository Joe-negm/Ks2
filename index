        if (!btn) return;
        const active = (currentLayoutMode === tabKey) || (tabKey === "AUTO" && currentLayoutMode !== "FOCUS_0" && currentLayoutMode !== "FOCUS_1");
        btn.className = active
          ? "flex-1 py-1.5 px-2 rounded-xl text-xs font-black bg-sky-600 text-white transition cursor-pointer truncate"
