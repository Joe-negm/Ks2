      const arena0 = document.getElementById("arena-0");
      const arena1 = document.getElementById("arena-1");
      if (!mainGrid || !arena0 || !arena1) return;

      const isDesktopSize = window.innerWidth >= 1024 && window.innerHeight >= 640;

      if (currentLayoutMode === "STACK") {
        document.body.classList.remove("viewport-locked");
        document.body.classList.add("viewport-scroll");
      } else if (isDesktopSize) {
        document.body.classList.add("viewport-locked");
        document.body.classList.remove("viewport-scroll");
      } else {
        document.body.classList.remove("viewport-locked");
        document.body.classList.add("viewport-scroll");
      }

      if (currentLayoutMode === "FOCUS_0") {
        arena0.classList.remove("hidden");
        arena1.classList.add("hidden");
        mainGrid.className = "flex-1 min-h-0 max-w-[2200px] w-full mx-auto p-2 sm:p-2.5 grid grid-cols-1 gap-2.5";
      } else if (currentLayoutMode === "FOCUS_1") {
