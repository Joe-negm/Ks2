    function importBulkQuestions() {
      const ta = document.getElementById("bulkQuestionText");
      if (!ta) return;
      const lines = ta.value.split("\n").map(l => l.trim()).filter(Boolean);
      if (lines.length === 0) {
        showToast("Paste lines to import.", "warning");
        return;
      }

      let addedCount = 0;
      lines.forEach((line, idx) => {
        const parts = line.split("|").map(p => p.trim());
        if (parts.length >= 4) {
          const topic = parts[0] || "Place Value & Partitioning";
          const ptsRaw = parseInt(parts[1], 10);
          const points = [10, 20, 30].includes(ptsRaw) ? ptsRaw : 10;
          const qText = parts[2];
          const ansText = parts[3];
          const hintText = parts[4] || "Count carefully step by step!";
          if (qText && ansText) {
            customQuestions.push({
              id: `custom-bulk-${Date.now()}-${idx}`,
              topic,
              points,
              q: qText,
              answer: ansText,
              hint: hintText,
              isCustom: true,
              isWordProblem: points === 30
            });
            addedCount++;
          }
        }
      });

      if (addedCount > 0) {
        persistCustomQuestions();
        ta.value = "";
        closeAddQuestionModal();
        showToast(`Imported ${addedCount} question(s)!`, "success");
      } else {
        showToast("Format: Topic | Points | Question | Answer | Hint", "warning");
      }
    }

