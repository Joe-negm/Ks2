    function resizeAllWheels() {
      [0, 1].forEach(idx => {
        const col = document.getElementById(`wheelColumn-${idx}`);
        const canvas = document.getElementById(`wheelCanvas-${idx}`);
        if (!col || !canvas) return;
        const wrapper = canvas.parentElement;
        const colWidth = col.clientWidth || 220;
        const colHeight = col.clientHeight || 320;
        const targetCssSize = Math.max(135, Math.min(250, colWidth - 28, colHeight - 115));
        if (wrapper) {
          wrapper.style.setProperty("--wheel-size", `${targetCssSize}px`);
        }
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const targetPx = Math.round(targetCssSize * dpr);
        if (canvas.width !== targetPx || canvas.height !== targetPx) {
          canvas.width = targetPx;
          canvas.height = targetPx;
        }
        drawWheel(idx);
      });
    }

