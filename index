    function formatClockMs(ms) {
      const safeMs = Math.max(0, Number(ms) || 0);
      const totalTenths = Math.floor(safeMs / 100);
      const tenths = totalTenths % 10;
      const totalSeconds = Math.floor(totalTenths / 10);
      const mins = Math.floor(totalSeconds / 60);
      const secs = totalSeconds % 60;
      return `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}.${tenths}`;
    }

    function startChessClockLoop() {
      if (chessClock.intervalId) clearInterval(chessClock.intervalId);
      chessClock.lastTickTimestamp = performance.now();
      chessClock.intervalId = setInterval(() => {
        if (!chessClock.isRunning) {
          chessClock.lastTickTimestamp = performance.now();
          return;
        }
        const now = performance.now();
        const elapsed = now - (chessClock.lastTickTimestamp || now);
        chessClock.lastTickTimestamp = now;

        const p = chessClock.activePlayer;
        if (chessClock.flagged[p]) {
          chessClock.isRunning = false;
          renderChessClockUI();
          return;
        }

        chessClock.timeMs[p] = Math.max(0, chessClock.timeMs[p] - elapsed);

        const remainingSec = Math.ceil(chessClock.timeMs[p] / 1000);
        if (remainingSec > 0 && remainingSec <= 10 && chessClock.lastWarnedSec[p] !== remainingSec) {
          chessClock.lastWarnedSec[p] = remainingSec;
          playTone(880, 0.05, "sine", 0.06);
        }

        if (chessClock.timeMs[p] <= 0) {
          chessClock.timeMs[p] = 0;
          chessClock.flagged[p] = true;
          chessClock.isRunning = false;
          playFlagSound();
          speakText(`${classesState[p].name}, time is up!`);
          showToast(`${classesState[p].name} ran out of time!`, "error");
        }

        renderChessClockUI();
      }, 100);
    }

    function toggleChessClockPause() {
      const p = chessClock.activePlayer;
      if (chessClock.flagged[p]) {
        showToast("Reset clock to continue after time expired.", "warning");
        return;
      }
      chessClock.isRunning = !chessClock.isRunning;
      chessClock.lastTickTimestamp = performance.now();
      playChessClickSound();
      renderChessClockUI();
    }

    function switchChessTurn() {
      const current = chessClock.activePlayer;
      const next = current === 0 ? 1 : 0;

      if (chessClock.flagged[next]) {
        showToast(`${classesState[next].name} already flagged.`, "warning");
        return;
      }

      if (chessClock.incrementMs > 0 && !chessClock.flagged[current]) {
        chessClock.timeMs[current] += chessClock.incrementMs;
      }
      chessClock.moves[current] += 1;

      if (chessClock.perQuestionReset) {
        chessClock.timeMs[next] = chessClock.baseMs;
        chessClock.flagged[next] = false;
      }

      chessClock.activePlayer = next;
      chessClock.isRunning = true;
      chessClock.lastTickTimestamp = performance.now();
      chessClock.lastWarnedSec[next] = null;

      playChessClickSound();
      renderChessClockUI();
    }

    function handleClockPadClick(playerIdx) {
      if (playerIdx === chessClock.activePlayer) {
        toggleChessClockPause();
      } else {
        chessClock.activePlayer = playerIdx;
        if (!chessClock.flagged[playerIdx]) {
          if (chessClock.perQuestionReset) {
            chessClock.timeMs[playerIdx] = chessClock.baseMs;
          }
          chessClock.isRunning = true;
          chessClock.lastTickTimestamp = performance.now();
