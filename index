    function drawQuestion(classIdx) {
      const st = classesState[classIdx];
      const ansInput = document.getElementById(`studentAnswerInput-${classIdx}`);
      if (ansInput) ansInput.value = "";

      const allQs = getAllActiveQuestions();
      let pool = allQs.filter(q => Number(q.points) === Number(st.selectedPoints));

      if (st.selectedTopic && st.selectedTopic !== "ALL") {
        const topicFiltered = pool.filter(q => q.topic === st.selectedTopic);
        if (topicFiltered.length > 0) {
          pool = topicFiltered;
        } else {
          const anyInTopic = allQs.filter(q => q.topic === st.selectedTopic);
          if (anyInTopic.length > 0) pool = anyInTopic;
        }
      }

      if (pool.length === 0) {
        st.currentQuestion = null;
        renderQuestionCard(classIdx);
        return;
      }

      const candidates = st.currentQuestion && pool.length > 1
        ? pool.filter(q => q.id !== st.currentQuestion.id)
        : pool;

      const picked = candidates[Math.floor(Math.random() * candidates.length)];
      st.currentQuestion = picked;
      st.hintVisible = false;
      st.answerVisible = false;
      renderQuestionCard(classIdx);
    }

    function toggleHint(classIdx) {
      if (!classesState[classIdx].currentQuestion) return;
      classesState[classIdx].hintVisible = !classesState[classIdx].hintVisible;
      renderQuestionCard(classIdx);
