<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Eastlands International School — Year 2 &amp; Year 3 Math Adventure</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@600;700;800;900&display=swap');

    :root {
      --navy: #1B2452;
      --crimson: #D9383A;
      --sky-bg: #eef7ff;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Nunito', 'Fredoka', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background: radial-gradient(circle at 12% 10%, #e0f2fe 0%, #f0f9ff 40%, #fef9c3 100%);
      color: #0f172a;
      max-width: 100%;
      overflow-x: hidden;
    }

    h1, h2, h3, .font-display {
      font-family: 'Fredoka', 'Nunito', system-ui, sans-serif;
    }

    body.viewport-locked {
      height: 100dvh;
      overflow-y: hidden;
    }

    body.viewport-scroll {
      min-height: 100dvh;
      overflow-y: auto;
    }

    .fluid-clock-time {
      font-size: clamp(1.3rem, 2.1vw, 2.05rem);
      line-height: 1;
    }

    .fluid-score-num {
      font-size: clamp(1.2rem, 1.8vw, 1.8rem);
      line-height: 1.05;
    }

    .fluid-question-text {
      font-size: clamp(0.98rem, 1.2vw, 1.25rem);
      line-height: 1.42;
    }

    .wheel-wrapper {
      position: relative;
      width: var(--wheel-size, 185px);
      height: var(--wheel-size, 185px);
      margin: 0 auto;
      flex-shrink: 0;
    }

    .wheel-canvas {
      width: 100%;
      height: 100%;
      display: block;
      border-radius: 9999px;
      background-color: #ffffff;
      box-shadow: 0 10px 22px -4px rgba(14, 116, 144, 0.25), 0 0 0 5px #ffffff, 0 0 0 8px #bae6fd;
    }

    .wheel-pointer {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 20;
      filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.3));
    }

    .class-body-grid {
      display: grid;
      grid-template-columns: minmax(195px, clamp(205px, 21vw, 275px)) minmax(0, 1fr);
    }

    @media (max-width: 639px) {
      .class-body-grid {
        grid-template-columns: 1fr;
      }
    }

    @keyframes lowTimePulse {
      0%, 100% { background-color: rgba(244, 63, 94, 0.14); }
      50% { background-color: rgba(244, 63, 94, 0.34); }
    }

    .clock-low-time {
      animation: lowTimePulse 0.8s infinite ease-in-out;
    }

    /* Dynamic Correct & Wrong Answer Animations */
    @keyframes celebrateCardPulse {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.65); }
      30% { transform: scale(1.022); box-shadow: 0 0 0 12px rgba(16, 185, 129, 0.22); }
      65% { transform: scale(0.995); box-shadow: 0 0 0 6px rgba(250, 204, 21, 0.35); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .anim-correct-card {
      animation: celebrateCardPulse 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      border-color: #10b981 !important;
      background-color: #ecfdf5 !important;
    }

    @keyframes playfulWobble {
      0%, 100% { transform: translateX(0) rotate(0deg); }
      16% { transform: translateX(-8px) rotate(-1.2deg); }
      33% { transform: translateX(8px) rotate(1.2deg); }
      50% { transform: translateX(-6px) rotate(-0.8deg); }
      66% { transform: translateX(6px) rotate(0.8deg); }
      83% { transform: translateX(-3px) rotate(-0.3deg); }
    }

    .anim-wrong-card {
      animation: playfulWobble 0.65s ease-in-out;
      border-color: #fb7185 !important;
      background-color: #fff1f2 !important;
    }

    @keyframes floatPointsUp {
      0% { opacity: 0; transform: translate(-50%, 10px) scale(0.6); }
      20% { opacity: 1; transform: translate(-50%, -8px) scale(1.18); }
      75% { opacity: 1; transform: translate(-50%, -44px) scale(1.05); }
      100% { opacity: 0; transform: translate(-50%, -70px) scale(0.95); }
    }

    .floating-reward-badge {
      position: fixed;
      z-index: 70;
      pointer-events: none;
      animation: floatPointsUp 1.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes confettiDrop {
      0% {
        opacity: 1;
        transform: translate(0, 0) rotate(0deg) scale(1);
      }
      100% {
        opacity: 0;
        transform: translate(var(--tx, 0px), var(--ty, 140px)) rotate(var(--rot, 360deg)) scale(0.65);
      }
    }

    .confetti-piece {
      position: fixed;
      z-index: 65;
      pointer-events: none;
      animation: confettiDrop 1.25s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
  </style>
</head>
<body class="viewport-scroll flex flex-col text-slate-900">

  <!-- ==================== TOP HEADER BAR ==================== -->
  <header class="bg-white/95 backdrop-blur-xs border-b-4 border-sky-400 shadow-xs shrink-0 z-20">
    <div class="max-w-[2200px] mx-auto px-2.5 sm:px-3.5 py-1.5 flex flex-wrap items-center justify-between gap-2">

      <!-- Left: Eastlands International School Logo & Kid-Friendly Competition Title -->
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="relative flex items-center justify-center bg-white rounded-2xl p-1 border-2 border-sky-200 shadow-2xs shrink-0">
          <img
            id="schoolLogoImg"
            src="image_8a5df4.png"
            alt="Eastlands International School Logo"
            class="h-9 sm:h-11 w-auto object-contain rounded-xl"
            onerror="handleLogoFallback(this)"
          />
          <div id="schoolLogoFallback" class="hidden items-center gap-1.5 px-1.5 py-0.5">
            <svg width="26" height="30" viewBox="0 0 100 112" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M50 4C28 4 12 14 12 14V54C12 82 50 106 50 106C50 106 88 82 88 54V14C88 14 72 4 50 4Z" fill="#FFFFFF" stroke="#1B2452" stroke-width="6"/>
              <circle cx="46" cy="52" r="26" stroke="#1B2452" stroke-width="3" stroke-dasharray="3 3"/>
              <circle cx="46" cy="52" r="18" stroke="#D9383A" stroke-width="2.5"/>
              <polygon points="46,16 52,46 82,46 54,56 46,88 38,56 14,52 38,46" fill="#1B2452"/>
              <polygon points="46,46 82,46 54,56 46,52" fill="#D9383A"/>
              <circle cx="46" cy="52" r="4" fill="#FFFFFF"/>
            </svg>
            <span class="text-[9px] font-black tracking-wider text-[#1B2452] leading-tight">EASTLANDS<br/>INT. SCHOOL</span>
          </div>
        </div>

        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="hidden sm:inline-block text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-[#1B2452] text-amber-300">
              Eastlands International School
            </span>
            <h1 class="text-sm sm:text-base md:text-lg font-black text-[#1B2452] tracking-tight truncate">
              🌟 Year 2 &amp; 3 Math Stars Challenge
            </h1>
            <button onclick="openBankModal()" id="bankCountBadge" class="text-[11px] font-extrabold px-2.5 py-0.5 rounded-full bg-emerald-100 hover:bg-emerald-200 text-emerald-800 border border-emerald-300 transition cursor-pointer shrink-0" title="Browse, add, or delete questions">
              Bank: 225 Qs
            </button>
          </div>
        </div>
      </div>

      <!-- Right: Controls -->
      <div class="flex flex-wrap items-center gap-1.5">
        <div class="inline-flex items-center bg-sky-50 border-2 border-sky-200 rounded-xl px-2 py-1 gap-1" title="Switch screen layout mode">
          <span class="text-[11px] font-extrabold text-sky-900 hidden sm:inline">View:</span>
          <select
            id="layoutModeSelect"
            onchange="setLayoutMode(this.value)"
            class="bg-transparent text-xs font-extrabold text-[#1B2452] outline-none cursor-pointer"
          >
            <option value="AUTO">Auto Fit</option>
            <option value="SPLIT">Split Arena (Both)</option>
            <option id="layoutOpt-0" value="FOCUS_0">Focus Year 2A</option>
            <option id="layoutOpt-1" value="FOCUS_1">Focus Year 2B</option>
            <option value="STACK">Compact Stack</option>
          </select>
        </div>

        <button onclick="openAddQuestionModal()" class="inline-flex items-center gap-1 px-3 py-1.5 min-h-[34px] rounded-xl text-xs font-black bg-amber-300 hover:bg-amber-200 text-slate-950 border-b-2 border-amber-500 shadow-2xs transition cursor-pointer">
          <span>✨ + Add Q</span>
        </button>

        <button onclick="openBankModal()" class="inline-flex items-center gap-1 px-2.5 py-1.5 min-h-[34px] rounded-xl text-xs font-extrabold bg-emerald-100 hover:bg-emerald-200 text-emerald-900 border border-emerald-300 transition cursor-pointer">
          <span>📚 Bank</span>
        </button>

        <label class="cursor-pointer inline-flex items-center gap-1 px-2.5 py-1.5 min-h-[34px] rounded-xl text-xs font-extrabold bg-sky-100 hover:bg-sky-200 text-sky-900 border border-sky-300 transition" title="Upload School PNG Logo">
          <span>🏫 Logo</span>
          <input type="file" accept="image/*" class="hidden" onchange="uploadCustomLogo(event)" />
        </label>

        <button id="soundToggleBtn" onclick="toggleSound()" class="inline-flex items-center gap-1 px-2.5 py-1.5 min-h-[34px] rounded-xl text-xs font-extrabold bg-purple-100 hover:bg-purple-200 text-purple-900 border border-purple-300 transition cursor-pointer">
          <span id="soundIcon">🔊</span>
          <span id="soundLabel" class="hidden md:inline">Sound: ON</span>
        </button>

        <button onclick="openResetModal()" class="inline-flex items-center gap-1 px-2.5 py-1.5 min-h-[34px] rounded-xl text-xs font-extrabold bg-rose-100 hover:bg-rose-200 text-rose-800 border border-rose-300 transition cursor-pointer">
          <span>↺</span>
          <span class="hidden sm:inline">Reset</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== TOAST CONTAINER ==================== -->
  <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-1.5 pointer-events-none"></div>

  <!-- ==================== DUAL CHESS TIMER HUB ==================== -->
  <section id="chessTimerHub" class="bg-gradient-to-r from-indigo-950 via-[#1B2452] to-purple-950 text-white border-b-4 border-amber-300 shrink-0">
    <div class="max-w-[2200px] mx-auto px-2.5 sm:px-3.5 py-1.5 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-12 gap-2 items-center">

      <!-- CLOCK PAD 0 -->
      <div
        id="clockPad-0"
        onclick="handleClockPadClick(0)"
        class="order-1 xl:col-span-4 rounded-2xl px-3 py-1.5 border-2 transition-all cursor-pointer select-none flex items-center justify-between gap-2 bg-white text-slate-900 border-sky-300 hover:border-sky-500"
      >
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span id="clockClassLabel-0" class="text-xs font-black uppercase tracking-wider text-sky-700 truncate">Year 2A</span>
            <span id="clockStatusBadge-0" class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-sky-100 text-sky-800 shrink-0">READY</span>
          </div>
          <div class="flex items-center gap-2 text-[11px] text-slate-500 font-bold mt-0.5">
            <span id="clockStudentLabel-0" class="truncate max-w-[125px] sm:max-w-[170px]">Spin the wheel!</span>
            <span>&bull; Turns: <strong id="clockMoves-0" class="text-slate-700">0</strong></span>
            <span id="clockFlagBanner-0" class="hidden text-[10px] font-black text-white bg-rose-500 px-1.5 py-0.5 rounded-full">TIME'S UP!</span>
          </div>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <span id="clockIncDisplay-0" class="text-[10px] font-extrabold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded-lg border border-emerald-200">+3s</span>
          <div id="clockTimeDisplay-0" class="fluid-clock-time font-black tabular-nums tracking-tight text-slate-800">
            05:00.0
          </div>
        </div>
      </div>

      <!-- CENTER CHESS CLOCK CONTROLS -->
      <div class="order-3 md:col-span-2 xl:order-2 xl:col-span-4 bg-white/10 backdrop-blur-xs rounded-2xl px-2.5 py-1.5 border border-white/20 flex flex-col gap-1">
        <div class="flex items-center justify-between gap-1.5">
          <button
            id="clockStartPauseBtn"
            onclick="toggleChessClockPause()"
            class="px-3 py-1.5 min-h-[34px] rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs transition flex items-center gap-1 shrink-0 cursor-pointer shadow-2xs"
            title="Start or Pause Clock (Shortcut: P)"
          >
            <span id="clockStartIcon">▶</span>
            <span id="clockStartLabel">Start</span>
          </button>

          <button
            id="clockSwitchTurnBtn"
            onclick="switchChessTurn()"
            class="flex-1 py-1.5 px-2.5 min-h-[34px] rounded-xl bg-gradient-to-r from-sky-500 via-amber-400 to-rose-500 hover:opacity-95 text-slate-950 font-black text-xs shadow-xs transition transform active:scale-95 flex items-center justify-center gap-1 cursor-pointer"
            title="Switch Active Clock (Shortcut: Spacebar)"
          >
            <span>⏱️ SWITCH TURN</span>
            <kbd class="hidden sm:inline text-[9px] px-1 py-0.2 bg-white/60 rounded border border-black/15 font-mono">Space</kbd>
          </button>

          <button
            onclick="resetChessClock()"
            class="px-2.5 py-1.5 min-h-[34px] rounded-xl bg-white/15 hover:bg-white/25 text-white font-extrabold text-xs transition shrink-0 cursor-pointer"
            title="Reset Clocks"
          >
            ↺
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-1.5 text-[11px]">
          <div class="flex items-center gap-1">
            <select
              id="chessPresetSelect"
              onchange="handlePresetDropdownChange(this.value)"
              class="bg-indigo-950 text-amber-300 font-extrabold text-[11px] rounded-lg px-1.5 py-0.5 border border-indigo-400/40 outline-none cursor-pointer"
              title="Select Chess Clock Time Control"
            >
              <option value="1,0">1:00 + 0s</option>
              <option value="3,2">3:00 + 2s</option>
              <option value="5,0">5:00 + 0s</option>
              <option value="5,3" selected>5:00 + 3s</option>
              <option value="10,5">10:00 + 5s</option>
              <option value="CUSTOM">Custom...</option>
            </select>

            <div id="customClockInputs" class="hidden items-center gap-0.5">
              <input id="customClockMins" type="number" min="0" max="60" value="5" class="w-8 bg-indigo-950 text-white text-center rounded px-0.5 py-0.2 font-bold border border-indigo-400 outline-none text-[11px]" />
              <span class="text-indigo-200">m+</span>
              <input id="customClockInc" type="number" min="0" max="60" value="3" class="w-8 bg-indigo-950 text-white text-center rounded px-0.5 py-0.2 font-bold border border-indigo-400 outline-none text-[11px]" />
              <button onclick="applyCustomChessTime()" class="px-1.5 py-0.2 rounded bg-amber-400 text-slate-950 font-black text-[10px] cursor-pointer">OK</button>
            </div>
          </div>

          <div class="flex items-center gap-2.5 text-indigo-100 font-bold">
            <label class="flex items-center gap-1 cursor-pointer select-none" title="Reset turn timer for every new question">
              <input id="perQuestionModeToggle" type="checkbox" onchange="togglePerQuestionMode(this.checked)" class="w-3.5 h-3.5 accent-amber-400 rounded cursor-pointer" />
              <span>Per-Turn</span>
            </label>
            <label class="flex items-center gap-1 cursor-pointer select-none" title="Automatically switch clock when teacher marks answer">
              <input id="autoSwitchToggle" type="checkbox" checked onchange="toggleAutoSwitchMode(this.checked)" class="w-3.5 h-3.5 accent-emerald-400 rounded cursor-pointer" />
              <span>Auto-Switch</span>
            </label>
          </div>
        </div>
      </div>

      <!-- CLOCK PAD 1 -->
      <div
        id="clockPad-1"
        onclick="handleClockPadClick(1)"
        class="order-2 xl:order-3 xl:col-span-4 rounded-2xl px-3 py-1.5 border-2 transition-all cursor-pointer select-none flex items-center justify-between gap-2 bg-white text-slate-900 border-rose-300 hover:border-rose-500"
      >
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span id="clockClassLabel-1" class="text-xs font-black uppercase tracking-wider text-rose-600 truncate">Year 2B</span>
            <span id="clockStatusBadge-1" class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-rose-100 text-rose-800 shrink-0">STANDBY</span>
          </div>
          <div class="flex items-center gap-2 text-[11px] text-slate-500 font-bold mt-0.5">
            <span id="clockStudentLabel-1" class="truncate max-w-[125px] sm:max-w-[170px]">Spin the wheel!</span>
            <span>&bull; Turns: <strong id="clockMoves-1" class="text-slate-700">0</strong></span>
            <span id="clockFlagBanner-1" class="hidden text-[10px] font-black text-white bg-rose-500 px-1.5 py-0.5 rounded-full">TIME'S UP!</span>
          </div>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <span id="clockIncDisplay-1" class="text-[10px] font-extrabold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded-lg border border-emerald-200">+3s</span>
          <div id="clockTimeDisplay-1" class="fluid-clock-time font-black tabular-nums tracking-tight text-slate-800">
            05:00.0
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== MOBILE / TABLET QUICK VIEW TABS ==================== -->
  <div id="mobileClassTabs" class="lg:hidden bg-white border-b-2 border-sky-200 px-2.5 py-1.5 flex items-center justify-center gap-1.5 shrink-0">
    <button id="mobTab-AUTO" onclick="setLayoutMode('AUTO')" class="flex-1 py-1.5 px-2 rounded-xl text-xs font-extrabold bg-sky-600 text-white transition cursor-pointer">
      Both Classes
    </button>
    <button id="mobTab-FOCUS_0" onclick="setLayoutMode('FOCUS_0')" class="flex-1 py-1.5 px-2 rounded-xl text-xs font-extrabold bg-slate-100 text-slate-700 transition cursor-pointer truncate">
      Year 2A Only
    </button>
    <button id="mobTab-FOCUS_1" onclick="setLayoutMode('FOCUS_1')" class="flex-1 py-1.5 px-2 rounded-xl text-xs font-extrabold bg-slate-100 text-slate-700 transition cursor-pointer truncate">
      Year 2B Only
    </button>
  </div>

  <!-- ==================== DUAL-CLASS ARENA ==================== -->
  <main id="arenaMainGrid" class="flex-1 min-h-0 max-w-[2200px] w-full mx-auto p-2 sm:p-2.5 grid grid-cols-1 lg:grid-cols-2 gap-2.5">

    <!-- CLASS 1 ARENA (SKY BLUE & SUNSHINE THEME) -->
    <section id="arena-0" class="bg-white rounded-3xl shadow-md border-3 border-sky-300 overflow-hidden flex flex-col min-h-0">
      <div class="bg-gradient-to-r from-sky-600 via-blue-600 to-indigo-600 text-white px-3.5 py-2 flex items-center justify-between gap-2 shrink-0">
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-8 h-8 rounded-2xl bg-amber-300 text-slate-950 flex items-center justify-center font-black text-base shadow-2xs shrink-0">🚀</span>
          <div class="relative flex items-center min-w-0">
            <input
              id="className-0"
              type="text"
              value="Year 2A"
              maxlength="28"
              aria-label="Edit First Class Name"
              oninput="updateClassName(0, this.value, false)"
              onchange="updateClassName(0, this.value, true)"
              onkeydown="if(event.key==='Enter'){this.blur();}"
              placeholder="e.g. Year 2A"
              class="bg-white/20 hover:bg-white/30 focus:bg-white focus:text-sky-900 text-white placeholder-sky-100 font-black text-sm sm:text-base pl-2.5 pr-7 py-0.5 rounded-xl border border-white/40 focus:border-amber-300 outline-none transition w-36 sm:w-48"
              title="Click to edit class or team name (e.g., Year 2A or Year 3A)"
            />
            <button
              type="button"
              onclick="focusClassNameInput(0)"
              class="absolute right-1.5 text-[11px] text-white/90 hover:text-amber-300 pointer-events-auto cursor-pointer"
              title="Edit class name"
            >✎</button>
          </div>
          <span class="hidden sm:inline text-[11px] text-sky-100 font-bold whitespace-nowrap">
            Done: <strong id="answeredCount-0" class="text-white">0</strong> &bull; Wheel: <strong id="wheelCount-0" class="text-amber-300">0</strong>
          </span>
        </div>

        <div id="scoreBox-0" class="flex items-center gap-2 bg-black/20 px-3 py-1 rounded-2xl border border-white/25 shrink-0">
          <div class="text-right">
            <div class="text-[9px] uppercase tracking-wider text-amber-200 font-black leading-none">⭐ Stars</div>
            <div id="scoreDisplay-0" class="fluid-score-num font-black text-amber-300 tabular-nums">0</div>
          </div>
          <div class="flex flex-col gap-0.5">
            <button onclick="adjustScore(0, 10)" class="px-1.5 py-0.5 rounded-lg bg-emerald-400 hover:bg-emerald-300 text-slate-950 text-[10px] font-black transition leading-tight cursor-pointer">+10</button>
            <button onclick="adjustScore(0, -10)" class="px-1.5 py-0.5 rounded-lg bg-rose-400 hover:bg-rose-300 text-slate-950 text-[10px] font-black transition leading-tight cursor-pointer">-10</button>
          </div>
        </div>
      </div>

      <div class="class-body-grid flex-1 min-h-0 divide-y sm:divide-y-0 sm:divide-x divide-sky-100">
        <!-- LEFT: WHEEL + ROSTER -->
        <div id="wheelColumn-0" class="relative bg-gradient-to-b from-sky-50/90 to-indigo-50/60 p-2.5 flex flex-col justify-between gap-2 min-h-0 overflow-y-auto">
          <div class="flex items-center justify-between gap-1">
            <span id="wheelHeaderLabel-0" class="text-[11px] font-black uppercase tracking-wider text-sky-800 truncate">🎡 Year 2A Wheel</span>
            <div class="flex items-center gap-1 shrink-0">
              <button id="restoreBtn-0" onclick="restoreRemovedNames(0)" class="hidden text-[10px] font-extrabold px-2 py-0.5 rounded-lg bg-amber-200 text-amber-950 hover:bg-amber-300 transition cursor-pointer" title="Restore removed student names">
                Restore
              </button>
              <button onclick="toggleRosterDrawer(0)" class="text-[10px] font-extrabold px-2 py-0.5 rounded-lg bg-white hover:bg-sky-100 text-sky-900 border border-sky-300 transition cursor-pointer">
                Names (<span id="rosterBadgeCount-0">0</span>)
              </button>
