    function importCustomQuestionsJSON(event) {
      try {
        const input = event && event.target;
        const file = input && input.files && input.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (e) {
          try {
            const parsed = JSON.parse(e.target.result);
            if (!Array.isArray(parsed)) {
              showToast("Invalid JSON format.", "error");
              return;
            }
            const valid = parsed
              .filter(item => item && item.q && item.answer)
              .map((item, idx) => ({
                id: item.id || `custom-json-${Date.now()}-${idx}`,
                topic: item.topic || "Place Value & Partitioning",
                points: [10, 20, 30].includes(Number(item.points)) ? Number(item.points) : 10,
                q: String(item.q),
                answer: String(item.answer),
                hint: String(item.hint || "Count carefully step by step!"),
                isCustom: true,
                isWordProblem: Number(item.points) === 30
              }));
            customQuestions.push(...valid);
            persistCustomQuestions();
            renderBankModalList();
            if (input) input.value = "";
            showToast(`Loaded ${valid.length} custom question(s).`, "success");
          } catch (err) {
            showToast("Could not parse JSON file.", "error");
          }
        };
        reader.readAsText(file);
      } catch (e) {
        showToast("File read failed.", "error");
      }
    }

    function deleteQuestionById(qId) {
      if (!qId) return;
      if (String(qId).startsWith("builtin-")) {
        if (!deletedBuiltinIds.includes(qId)) {
          deletedBuiltinIds.push(qId);
          persistDeletedBuiltins();
        }
      } else {
        customQuestions = customQuestions.filter(q => q.id !== qId);
        persistCustomQuestions();
      }
      selectedBankIds.delete(qId);

      [0, 1].forEach(idx => {
        if (classesState[idx].currentQuestion && classesState[idx].currentQuestion.id === qId) {
          drawQuestion(idx);
        }
      });

      renderBankModalList();
      showToast("Question removed from bank.", "info");
    }

    function deleteSelectedBankQuestions() {
      if (selectedBankIds.size === 0) return;
      const idsToDelete = Array.from(selectedBankIds);
      idsToDelete.forEach(qId => {
        if (String(qId).startsWith("builtin-")) {
          if (!deletedBuiltinIds.includes(qId)) deletedBuiltinIds.push(qId);
        } else {
          customQuestions = customQuestions.filter(q => q.id !== qId);
        }
      });
      selectedBankIds.clear();
      persistDeletedBuiltins();
      persistCustomQuestions();

      [0, 1].forEach(idx => {
        if (classesState[idx].currentQuestion && idsToDelete.includes(classesState[idx].currentQuestion.id)) {
          drawQuestion(idx);
        }
      });

      renderBankModalList();
      showToast(`Deleted ${idsToDelete.length} selected question(s).`, "info");
    }

    function restoreDeletedBuiltins() {
      deletedBuiltinIds = [];
      persistDeletedBuiltins();
      renderBankModalList();
      [0, 1].forEach(idx => {
        if (!classesState[idx].currentQuestion) drawQuestion(idx);
      });
      showToast("All built-in Year 2 & 3 questions restored!", "success");
    }

    function openBankModal() {
      refreshTopicDropdowns();
      const m = document.getElementById("bankModal");
      if (m) m.classList.remove("hidden");
      renderBankModalList();
    }

    function closeBankModal() {
      const m = document.getElementById("bankModal");
      if (m) m.classList.add("hidden");
    }

    function getFilteredBankQuestions() {
      const search = (document.getElementById("bankSearchInput")?.value || "").trim().toLowerCase();
      const topic = document.getElementById("bankTopicFilter")?.value || "ALL";
      const pts = document.getElementById("bankPointsFilter")?.value || "ALL";

      return getAllActiveQuestions().filter(q => {
        if (topic !== "ALL" && q.topic !== topic) return false;
        if (pts !== "ALL" && String(q.points) !== String(pts)) return false;
        if (search) {
          const hay = `${q.q} ${q.topic} ${q.answer}`.toLowerCase();
          if (!hay.includes(search)) return false;
        }
        return true;
      });
    }

    function toggleBankSelection(qId, checked) {
      if (checked) selectedBankIds.add(qId);
      else selectedBankIds.delete(qId);
      updateBankSelectionToolbar(getFilteredBankQuestions());
    }

    function toggleSelectAllFiltered(checked) {
      const filtered = getFilteredBankQuestions();
      if (checked) {
        filtered.forEach(q => selectedBankIds.add(q.id));
      } else {
        filtered.forEach(q => selectedBankIds.delete(q.id));
      }
      renderBankModalList();
    }

    function updateBankSelectionToolbar(filtered) {
      const countEl = document.getElementById("selectedBankCount");
      const delBtn = document.getElementById("deleteSelectedBtn");
      const allBox = document.getElementById("selectAllFilteredCheckbox");

      if (countEl) countEl.textContent = String(selectedBankIds.size);
      if (delBtn) delBtn.disabled = selectedBankIds.size === 0;
      if (allBox) {
        allBox.checked = filtered.length > 0 && filtered.every(q => selectedBankIds.has(q.id));
      }
    }

    function renderBankModalList() {
      const listEl = document.getElementById("bankModalList");
      const statsEl = document.getElementById("bankModalStats");
      const restoreBtn = document.getElementById("restoreBuiltinBtn");

      if (restoreBtn) {
        if (deletedBuiltinIds.length > 0) restoreBtn.classList.remove("hidden");
        else restoreBtn.classList.add("hidden");
      }

      const filtered = getFilteredBankQuestions();
      if (statsEl) {
        statsEl.textContent = `Showing ${filtered.length} of ${getAllActiveQuestions().length} active questions (${deletedBuiltinIds.length} deleted)`;
      }

      updateBankSelectionToolbar(filtered);

      if (!listEl) return;
      if (filtered.length === 0) {
        listEl.innerHTML = `<div class="text-center py-8 text-slate-400 text-xs font-extrabold">No questions match your filter.</div>`;
        return;
      }

      listEl.innerHTML = filtered
        .map(q => {
          const isChecked = selectedBankIds.has(q.id);
          return `
            <div class="p-3 rounded-2xl border border-slate-200 bg-slate-50/80 flex items-start justify-between gap-3">
              <label class="flex items-start gap-2.5 flex-1 min-w-0 cursor-pointer">
                <input type="checkbox" ${isChecked ? "checked" : ""} onchange="toggleBankSelection('${escapeHtml(q.id)}', this.checked)" class="mt-1 w-4 h-4 rounded cursor-pointer shrink-0" />
                <div class="min-w-0 space-y-1">
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="px-2 py-0.5 rounded-lg text-[10px] font-black bg-sky-600 text-white">${escapeHtml(q.topic)}</span>
                    <span class="px-2 py-0.5 rounded-lg text-[10px] font-black bg-amber-100 text-amber-950">${q.points} Stars</span>
                    ${q.isCustom ? `<span class="px-2 py-0.5 rounded-lg text-[10px] font-extrabold bg-purple-100 text-purple-900">Teacher Q</span>` : ""}
                  </div>
                  <p class="text-xs font-extrabold text-slate-900">${escapeHtml(q.q)}</p>
                  <p class="text-[11px] text-emerald-700 font-extrabold">Answer: ${escapeHtml(q.answer)}</p>
                </div>
              </label>
              <button onclick="deleteQuestionById('${escapeHtml(q.id)}')" class="px-2.5 py-1 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-extrabold transition shrink-0 cursor-pointer">
                Delete
              </button>
            </div>
          `;
        })
        .join("");
    }

    // =========================================================================
    // KEYBOARD SHORTCUTS & BOOTSTRAP
    // =========================================================================
    document.addEventListener("keydown", function (e) {
      const tag = (e.target && e.target.tagName || "").toLowerCase();
      if (tag === "input" || tag === "textarea" || tag === "select") return;

      if (e.code === "Space") {
        e.preventDefault();
        switchChessTurn();
      } else if (e.key === "p" || e.key === "P") {
        toggleChessClockPause();
      }
    });

    function initApp() {
      try {
        refreshTopicDropdowns();
        updateSoundButtonUI();
        syncChessClockSettingsUI();
        startChessClockLoop();
        syncClassNameLabels(0, true);
        syncClassNameLabels(1, true);
        renderChessClockUI();
        renderClassUI(0);
        renderClassUI(1);
        applyResponsiveLayout();

        if (typeof ResizeObserver !== "undefined") {
          const ro = new ResizeObserver(() => resizeAllWheels());
          [0, 1].forEach(idx => {
            const col = document.getElementById(`wheelColumn-${idx}`);
            if (col) ro.observe(col);
          });
        }
        window.addEventListener("resize", () => applyResponsiveLayout());
      } catch (err) {
        document.body.style.backgroundColor = "#f0f9ff";
        document.body.style.color = "#0f172a";
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initApp);
    } else {
      initApp();
    }
  </script>
</body>
</html>
