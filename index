    // Intelligent kid-friendly answer matcher (handles units, $, £, spaces, and leading numbers)
    function checkTypedAnswer(classIdx) {
      const st = classesState[classIdx];
      const q = st.currentQuestion;
      if (!q) {
        showToast("Load a question first!", "warning");
        return;
      }
      const inp = document.getElementById(`studentAnswerInput-${classIdx}`);
      const rawUser = (inp ? inp.value : "").trim();
      if (!rawUser) {
        showToast("Type your answer in the box first!", "warning");
        return;
      }

      const normalize = s => String(s || "")
        .toLowerCase()
        .replace(/[$£€°,]/g, "")
        .replace(/\b(cm|m|g|kg|ml|l|mins|minutes|hours|days|weeks|years|sweets|apples|pencils|pots|boxes|stickers|cars|shells|nuts|children|legs|wheels|sides|faces|vertices|edges|stars|books|cans|eggs|groups|birds)\b/g, "")
        .replace(/\s+/g, " ")
        .trim();

      const normUser = normalize(rawUser);
      const normOfficial = normalize(q.answer);
      const userFirstToken = normUser.split(" ")[0];
      const officialFirstToken = normOfficial.split(" ")[0];

      const isMatch =
        normUser === normOfficial ||
        (userFirstToken && userFirstToken === officialFirstToken && !isNaN(Number(userFirstToken)));

      if (isMatch) {
        if (inp) inp.value = "";
        markAnswer(classIdx, true);
      } else {
        playWrongBoing();
        triggerAnswerFeedbackEffects(classIdx, false, 0);
        showToast(`💪 Good try! Check your answer or ask for a hint!`, "warning");
      }
    }

    function markAnswer(classIdx, isCorrect) {
      const st = classesState[classIdx];
      const q = st.currentQuestion;
      const pts = q ? Number(q.points) || st.selectedPoints : st.selectedPoints;

      if (isCorrect) {
        st.answeredCount += 1;
        st.score += pts;
        playCorrectFanfare();
        triggerAnswerFeedbackEffects(classIdx, true, pts);
        showToast(`🎉 Superstar! +${pts} stars for ${st.name}!`, "success");

        if (chessClock.autoSwitchOnAnswer && chessClock.isRunning) {
          switchChessTurn();
