    function drawWheel(classIdx) {
      const canvas = document.getElementById(`wheelCanvas-${classIdx}`);
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const w = canvas.width;
      const h = canvas.height;
      const cx = w / 2;
      const cy = h / 2;
      const r = Math.max(10, Math.min(cx, cy) - 4);

      ctx.clearRect(0, 0, w, h);

      const names = classesState[classIdx].wheelNames;
      const angle = classesState[classIdx].wheelAngle || 0;

      if (!names || names.length === 0) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.fillStyle = classIdx === 0 ? "#f0f9ff" : "#fff1f2";
        ctx.fill();
        ctx.lineWidth = Math.max(2, r * 0.03);
        ctx.strokeStyle = classIdx === 0 ? "#7dd3fc" : "#fda4af";
        ctx.stroke();

        ctx.setLineDash([6, 6]);
        ctx.beginPath();
        ctx.arc(cx, cy, r * 0.72, 0, Math.PI * 2);
        ctx.strokeStyle = "#94a3b8";
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.fillStyle = "#334155";
        ctx.font = `800 ${Math.max(11, Math.round(r * 0.13))}px Nunito, sans-serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText("EMPTY WHEEL", cx, cy - r * 0.08);

        ctx.fillStyle = "#64748b";
        ctx.font = `700 ${Math.max(9, Math.round(r * 0.095))}px Nunito, sans-serif`;
        ctx.fillText("Add student names", cx, cy + r * 0.12);
        ctx.restore();
        return;
      }

      const sliceArc = (Math.PI * 2) / names.length;

      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(angle);

      for (let i = 0; i < names.length; i++) {
        const startA = i * sliceArc;
        const endA = startA + sliceArc;

        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.arc(0, 0, r, startA, endA);
        ctx.closePath();
        ctx.fillStyle = WHEEL_PALETTE[i % WHEEL_PALETTE.length];
        ctx.fill();
        ctx.lineWidth = 2.5;
        ctx.strokeStyle = "#ffffff";
        ctx.stroke();

        ctx.save();
        ctx.rotate(startA + sliceArc / 2);
        ctx.textAlign = "right";
        ctx.textBaseline = "middle";
        ctx.fillStyle = "#ffffff";
        const fontSize = Math.max(10, Math.min(16, Math.round(r * 0.135)));
        ctx.font = `800 ${fontSize}px Nunito, sans-serif`;
        const label = String(names[i]);
        const truncated = label.length > 13 ? label.slice(0, 12) + "…" : label;
        ctx.fillText(truncated, r - Math.max(10, r * 0.1), 0);
        ctx.restore();
      }

      ctx.restore();

      // Center star hub
      ctx.beginPath();
      ctx.arc(cx, cy, Math.max(11, r * 0.15), 0, Math.PI * 2);
      ctx.fillStyle = "#FACC15";
      ctx.fill();
      ctx.lineWidth = 3;
      ctx.strokeStyle = "#ffffff";
      ctx.stroke();
    }

    function spinWheel(classIdx) {
      const st = classesState[classIdx];
      if (st.isSpinning) return;
      if (!st.wheelNames || st.wheelNames.length === 0) {
        showToast(`Add student names to ${st.name} wheel first!`, "warning");
        return;
      }

      st.isSpinning = true;
      renderClassUI(classIdx);

      const n = st.wheelNames.length;
      const sliceArc = (Math.PI * 2) / n;
      const winnerIdx = Math.floor(Math.random() * n);

      const targetCenterInWheel = winnerIdx * sliceArc + sliceArc / 2;
      const desiredMod = ((-Math.PI / 2 - targetCenterInWheel) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
      const currentMod = ((st.wheelAngle % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
      let deltaMod = desiredMod - currentMod;
      if (deltaMod < 0) deltaMod += Math.PI * 2;

      const extraSpins = (5 + Math.floor(Math.random() * 3)) * Math.PI * 2;
      const startAngle = st.wheelAngle;
      const finalAngle = startAngle + extraSpins + deltaMod;
      const durationMs = 2600;
      const startTime = performance.now();
      let lastTickIndex = -1;

      function animateFrame(now) {
        const progress = Math.min(1, (now - startTime) / durationMs);
        const eased = 1 - Math.pow(1 - progress, 3);
        st.wheelAngle = startAngle + (finalAngle - startAngle) * eased;

        const currentSlice = Math.floor((((st.wheelAngle % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2)) / sliceArc);
        if (currentSlice !== lastTickIndex) {
          lastTickIndex = currentSlice;
          playTone(620 + (currentSlice % 5) * 75, 0.035, "triangle", 0.055);
        }

        drawWheel(classIdx);

        if (progress < 1) {
          requestAnimationFrame(animateFrame);
        } else {
          const pickedName = st.wheelNames[winnerIdx];
          st.wheelNames.splice(winnerIdx, 1);
          st.removedNames.push(pickedName);
          st.currentContestant = pickedName;
          st.isSpinning = false;

          playWheelWinnerFanfare();
          speakText(`${pickedName} from ${st.name}, it's your turn!`);
          showToast(`🌟 Selected: ${pickedName}!`, "success");

          if (!st.currentQuestion) {
            drawQuestion(classIdx);
          }
          renderClassUI(classIdx);
          renderNameChips(classIdx);
          renderChessClockUI();
        }
      }

      requestAnimationFrame(animateFrame);
    }

